services:

  {{ service_name }}:
    image: {{ services.image }}
    container_name: {{ service_name }}
    restart: {{ services.restart_policy }}
    environment:
      - MODE={{ services.mode }}
      - APP_VERSION={{ services.version }}
      - APP_PORT={{ services.port }}
    volumes:
      - {{ services.log_volume }}:/var/log/app
    networks:
      - {{ network.name }}
    expose:
      - "{{ services.port }}"
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:{{ services.port }}/healthz')"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s

  nginx:
    image: {{ nginx.image }}
    container_name: swiftdeploy-nginx
    restart: {{ services.restart_policy }}
    ports:
      - "{{ nginx.port }}:{{ nginx.port }}"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - nginx-logs:/var/log/nginx
    networks:
      - {{ network.name }}
    depends_on:
      {{ service_name }}:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:{{ nginx.port }}/healthz"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s

volumes:
  {{ services.log_volume }}:
  nginx-logs:

networks:
  {{ network.name }}:
    driver: {{ network.driver_type }}
